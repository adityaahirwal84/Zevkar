# ==============================================================================
# Zevkar.ai Automation Intelligence Platform — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME & DOMAIN (Required / Recommended Defaults)
# ------------------------------------------------------------------------------
# PORT: Port on which the HTTP server listens.
# Status: Optional | Default: 3000 | Format: Integer (e.g., 3000, 8080)
PORT=3000

# NODE_ENV: Application environment mode.
# Status: Optional | Default: development | Allowed: development, production, test
NODE_ENV=development

# APP_URL: Base URL where this application is hosted. Used for canonical links, callbacks, and HMR proxying.
# Status: Optional in dev (default http://localhost:3000) | Production domain: https://zevkar.ai
APP_URL=http://localhost:3000

# NEXT_PUBLIC_APP_URL / FRONTEND_BASE_URL: Public frontend origin for Next.js metadata and backend callbacks.
# Status: Optional in dev | Production: https://zevkar.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# CORS_ORIGINS: Comma-separated allowed browser origins in production mode.
# Status: Optional | Defaults include http://localhost:3000 and https://zevkar.ai
CORS_ORIGINS=http://localhost:3000,https://zevkar.ai,https://www.zevkar.ai

# DISABLE_HMR: Set to 'true' to explicitly disable Vite Hot Module Replacement.
# Status: Optional | Default: false | Allowed: true, false
DISABLE_HMR=false

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: API Key for Google Gemini LLM API calls.
# Status: Required for real Gemini calls (Optional for deterministic fallback engine)
# Format: String (e.g., AIzaSy...)
# Note: Google AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GEMINI_MODEL: Model alias or full model name for root cause diagnosis and assistant chat.
# Status: Optional | Default: gemini-4-hydrogen | Allowed: gemini-4-hydrogen
GEMINI_MODEL=gemini-4-hydrogen

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (FastAPI / SQLAlchemy backend)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string with asyncpg driver.
# Status: Optional in dev (in-memory mock store active); Required for production Python backend.
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/automation_doctor

# ------------------------------------------------------------------------------
# 4. QUEUES & CELERY BACKGROUND WORKERS
# ------------------------------------------------------------------------------
# REDIS_URL: Redis instance connection string for caching and task coordination.
# Status: Optional in dev; Required for production background workers.
# Format: redis://<host>:<port>/<db_index>
REDIS_URL=redis://localhost:6379/0

# CELERY_BROKER_URL: Message broker URL for Celery scheduled tasks (n8n sync & stuck run polling).
# Status: Optional in dev; Required for Celery Beat / Worker.
# Format: redis://<host>:<port>/<db_index> or amqp://<user>:<password>@<host>:<port>/
CELERY_BROKER_URL=redis://localhost:6379/1

# CELERY_RESULT_BACKEND: Celery task result backend.
# Status: Optional | Format: redis://<host>:<port>/<db_index>
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographic secret key used to sign and verify JWT access and refresh tokens.
# Status: Required in production | Format: 32+ character random string
SECRET_KEY=change_this_to_a_secure_random_32_character_string

# ACCESS_TOKEN_EXPIRE_MINUTES: Lifetime of JWT tokens before rotation.
# Status: Optional | Default: 1440 (24 hours) | Format: Integer
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
# ENABLE_PROMETHEUS: Enables the /metrics scrape endpoint for Grafana dashboards.
# Status: Optional | Default: true | Allowed: true, false
ENABLE_PROMETHEUS=true

# SENTRY_DSN: Data Source Name for Sentry exception reporting.
# Status: Optional | Format: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=
